    public static void register(CommandManager<CommandSender> manager) {
        manager.command(manager.commandBuilder("kick")
                .required("player", playerParser())
                .optional("reason", greedyFlagYieldingStringParser())
                .flag(manager.flagBuilder("silent").withAliases("s"))
                .permission("punishments.kick")
                .handler(KickCommands::kick));
    }

    private static void kick(CommandContext<CommandSender> ctx) {
